{"abstract":[{"text":"A custom model trained to classify or tag natural language text.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLModel"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"c:objc(cs)NLModel","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NLModel"}],"modules":[{"name":"Natural Language"}],"navigatorTitle":[{"kind":"identifier","text":"NLModel"}],"platforms":[{"introducedAt":"12.0","name":"iOS"},{"introducedAt":"12.0","name":"iPadOS"},{"introducedAt":"13.1","name":"Mac Catalyst"},{"introducedAt":"10.14","name":"macOS"},{"introducedAt":"12.0","name":"tvOS"},{"introducedAt":"1.0","name":"visionOS"},{"introducedAt":"5.0","name":"watchOS"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NLModel"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst","macOS","tvOS","visionOS","watchOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NLModel"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"With ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage","isActive":true,"type":"reference"},{"text":", you can create text classifier (","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/CreateML\/MLTextClassifier","isActive":true,"type":"reference"},{"text":") or word tagger (","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/CreateML\/MLWordTagger","isActive":true,"type":"reference"},{"text":") models. Use ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLModel","isActive":true,"type":"reference"},{"text":" to integrate those models into your app. This integration ensures that your tokenization and tagger configurations are identical when you train your model and use it in your app.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you create a text classifier as described in ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/CreateML\/creating-a-text-classifier-model","isActive":true,"type":"reference"},{"text":", you can integrate that model into your app and use it to make predictions like this:","type":"text"}],"type":"paragraph"},{"code":["let text = \"I am very happy.\"","","do {","    let mlModel = try SentimentClassifier(configuration: MLModelConfiguration()).model","        ","    let customModel = try NLModel(mlModel: mlModel)","    ","    \/\/ Use the text classifier model to get the most likely label.","    if let label = customModel.predictedLabel(for: text) {","        print(\"Most likely label: \\(label)\")","    }","    ","    \/\/ Get multiple possible labels with their associated confidence scores.","    let labelHypotheses = customModel.predictedLabelHypotheses(for: text, maximumCount: 3)","    print(\"Label confidence scores: \\(labelHypotheses)\")","    ","} catch {","    print(error)","}"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"inlineContent":[{"text":"If you create a custom word tagger as described in ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/CreateML\/creating-a-word-tagger-model","isActive":true,"type":"reference"},{"text":", you can integrate that model into your app and generate tags for new text input like this:","type":"text"}],"type":"paragraph"},{"code":["let text = \"The iPad is my favorite Apple product.\"","","do {","    let mlModel = try AppleTagger(configuration: MLModelConfiguration()).model","        ","    let customModel = try NLModel(mlModel: mlModel)","    let customTagScheme = NLTagScheme(\"Apple\")","    ","    let tagger = NLTagger(tagSchemes: [.nameType, customTagScheme])","    tagger.string = text","    tagger.setModels([customModel], forTagScheme: customTagScheme)","    ","    tagger.enumerateTags(in: text.startIndex..<text.endIndex, unit: .word, ","                         scheme: customTagScheme, options: .omitWhitespace) { tag, tokenRange  in","        if let tag = tag {","            print(\"\\(text[tokenRange]): \\(tag.rawValue)\")","        }","        return true","    }","} catch {","    print(error)","}"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/ObjectiveC\/NSObject-swift.class"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/Swift\/CVarArg","doc:\/\/com.apple.documentation\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.documentation\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.documentation\/documentation\/Swift\/Equatable","doc:\/\/com.apple.documentation\/documentation\/Swift\/Hashable","doc:\/\/com.apple.documentation\/documentation\/ObjectiveC\/NSObjectProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Natural-language-models","generated":true,"identifiers":["doc