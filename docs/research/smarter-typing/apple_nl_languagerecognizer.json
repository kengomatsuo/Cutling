{"abstract":[{"text":"The language of a body of text.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"c:objc(cs)NLLanguageRecognizer","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NLLanguageRecognizer"}],"modules":[{"name":"Natural Language"}],"navigatorTitle":[{"kind":"identifier","text":"NLLanguageRecognizer"}],"platforms":[{"introducedAt":"12.0","name":"iOS"},{"introducedAt":"12.0","name":"iPadOS"},{"introducedAt":"13.1","name":"Mac Catalyst"},{"introducedAt":"10.14","name":"macOS"},{"introducedAt":"12.0","name":"tvOS"},{"introducedAt":"1.0","name":"visionOS"},{"introducedAt":"5.0","name":"watchOS"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"NLLanguageRecognizer"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst","macOS","tvOS","visionOS","watchOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NLLanguageRecognizer"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/identifying-the-language-in-text"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer","isActive":true,"type":"reference"},{"text":" object automatically detects the language of a piece","type":"text"},{"text":" ","type":"text"},{"text":"of text. It performs language identification by:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Identifying the dominant script of a piece of text. Some languages have a","type":"text"},{"text":" ","type":"text"},{"text":"unique script (like Greek), but others share the same script (like English,","type":"text"},{"text":" ","type":"text"},{"text":"French, and German, which all share the Latin script).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Identifying the language itself.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"The identification obtained from an ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer","isActive":true,"type":"reference"},{"text":" object can be","type":"text"},{"text":" ","type":"text"},{"text":"either a single most likely language, accessed through ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/dominantLanguage","isActive":true,"type":"reference"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"text":"a set of language candidates with probabilities, using","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/languageHypotheses(withMaximum:)","isActive":true,"type":"reference"},{"text":". You can reset the recognizer to its initial","type":"text"},{"text":" ","type":"text"},{"text":"state, to be reused for new analysis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the convenience method, ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/dominantLanguage(for:)","isActive":true,"type":"reference"},{"text":", to get the most likely","type":"text"},{"text":" ","type":"text"},{"text":"language without creating an ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Language identification is most reliable for longer passages of text. For very","type":"text"},{"text":" ","type":"text"},{"text":"short inputs of only a few words, accuracy is lower, and for some text","type":"text"},{"text":" ","type":"text"},{"text":"there may be no well-defined answer at all. For example, personal names are","type":"text"},{"text":" ","type":"text"},{"text":"shared across languages and don’t belong definitively to any one of them. When","type":"text"},{"text":" ","type":"text"},{"text":"you work with short or ambiguous text, inspect the full set of","type":"text"},{"text":" ","type":"text"},{"text":"candidates with ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/languageHypotheses(withMaximum:)","isActive":true,"type":"reference"},{"text":" rather than relying on a","type":"text"},{"text":" ","type":"text"},{"text":"single ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/dominantLanguage","isActive":true,"type":"reference"},{"text":".  When you have prior knowledge about the input, like","type":"text"},{"text":" ","type":"text"},{"text":"a person’s preferred languages, bias the recognizer toward them with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/languageHints-3gy00","isActive":true,"type":"reference"},{"text":", or limit it to a known set with ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/languageConstraints","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Don’t use an instance of ","type":"text"},{"identifier":"doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer","isActive":true,"type":"reference"},{"text":" from more than","type":"text"},{"text":" ","type":"text"},{"text":"one thread simultaneously.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/ObjectiveC\/NSObject-swift.class"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/Swift\/CVarArg","doc:\/\/com.apple.documentation\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.documentation\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.documentation\/documentation\/Swift\/Equatable","doc:\/\/com.apple.documentation\/documentation\/Swift\/Hashable","doc:\/\/com.apple.documentation\/documentation\/ObjectiveC\/NSObjectProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Language-identification","generated":true,"identifiers":["doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/identifying-the-language-in-text","doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguage"],"title":"Language identification"}],"topicSections":[{"anchor":"Creating-a-recognizer","identifiers":["doc:\/\/com.apple.naturallanguage\/documentation\/NaturalLanguage\/NLLanguageRecognizer\/init()"],"title":"Creating a recognizer"},{"anchor":"Determining-the-language","identifiers":["doc: