{"abstract":[{"text":"Enhance the experience in your app by prompting an on-device large language model.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/generating-content-and-performing-tasks-with-foundation-models"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"images":[{"identifier":"foundation-models-PageImage-card.png","type":"card"}],"modules":[{"name":"Foundation Models"}],"role":"article","roleHeading":"Article","title":"Generating content and performing tasks with Foundation Models"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The Foundation Models framework lets you tap into the on-device large models at","type":"text"},{"text":" ","type":"text"},{"text":"the core of Apple Intelligence. You can enhance your app by using generative","type":"text"},{"text":" ","type":"text"},{"text":"models to create content or perform tasks. The framework supports language","type":"text"},{"text":" ","type":"text"},{"text":"understanding and generation based on model capabilities.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For design guidance, see Human Interface Guidelines > Technologies > ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/generative-ai","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Understand-model-capabilities","level":2,"text":"Understand model capabilities","type":"heading"},{"inlineContent":[{"text":"When considering features for your app, it helps to know what the on-device","type":"text"},{"text":" ","type":"text"},{"text":"language model can do. The on-device model supports text generation and","type":"text"},{"text":" ","type":"text"},{"text":"understanding that you can use to:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Capability","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Prompt example","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Summarize","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Summarize this article.”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Extract entities","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“List the people and places mentioned in this text.”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Understand text","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“What happens to the dog in this story?”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Refine or edit text","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Change this story to be in second person.”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Classify or judge text","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Is this text relevant to the topic ‘Swift’?”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Compose creative writing","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Generate a short bedtime story about a fox.”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Generate tags from text","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Provide two tags that describe the main topics of this text.”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Generate game dialog","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Respond in the voice of a friendly inn keeper.”","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The on-device language model may not be suitable for handling all requests, like:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Capabilities to avoid","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Prompt example","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Do basic math","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“How many b’s are there in bagel?”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Create code","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“Generate a Swift navigation list.”","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Perform logical reasoning","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"“If I’m at Apple Park facing Canada, what direction is Texas?”","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The model can complete complex generative tasks when you use guided generation or","type":"text"},{"text":" ","type":"text"},{"text":"tool calling. For more on handling complex tasks, or tasks that require extensive","type":"text"},{"text":" ","type":"text"},{"text":"world-knowledge, see ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/generating-swift-data-structures-with-guided-generation","isActive":true,"type":"reference"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/expanding-generation-with-tool-calling","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Check-for-availability","level":2,"text":"Check for availability","type":"heading"},{"inlineContent":[{"text":"Before you use the on-device model in your app, check that the model is available","type":"text"},{"text":" ","type":"text"},{"text":"by creating an instance of ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/SystemLanguageModel","isActive":true,"type":"reference"},{"text":" with the ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/SystemLanguageModel\/default","isActive":true,"type":"reference"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Model availability depends on whether the device and region supports Apple","type":"text"},{"text":" ","type":"text"},{"text":"Intelligence. For a list of supported devices, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.apple.com\/apple-intelligence\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"It can take some time for the model to download and become available when","type":"text"},{"text":" ","type":"text"},{"text":"a person turns on Apple Intelligence.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"Always verify model availability first, and plan for a fallback experience in","type":"text"},{"text":" ","type":"text"},{"text":"case the model is unavailable.","type":"text"}],"type":"paragraph"},{"code":["struct GenerativeView: View {","    \/\/ Create a reference to the system language model.","    private var model = SystemLanguageModel.default","","    var body: some View {","        switch model.availability {","        case .available:","            \/\/ Show your intelligence UI.","        case .unavailable(.deviceNotEligible):","            \/\/ Show an alternative UI.","        case .unavailable(.modelNotReady):","            \/\/ The model isn't ready because it's downloading or because of other system reasons.","        case .unavailable(let other):","            \/\/ The model is unavailable for an unknown reason.","        }","    }","}"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"anchor":"Create-a-session","level":2,"text":"Create a session","type":"heading"},{"inlineContent":[{"text":"After confirming that the model is available, create a ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelSession","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"object to call the model. For a single-turn interaction, create a new session","type":"text"},{"text":" ","type":"text"},{"text":"each time you call the model:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Create a session with the system model.","let session = LanguageModelSession()"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"inlineContent":[{"text":"For a multiturn interaction — where the model retains some knowledge of what","type":"text"},{"text":" ","type":"text"},{"text":"it produced — reuse the same session each time you call the model.","type":"text"}],"type":"paragraph"},{"anchor":"Provide-a-prompt-to-the-model","level":2,"text":"Provide a prompt to the model","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Prompt","isActive":true,"type":"reference"},{"text":" is an input that the model responds to. Prompt engineering is the art","type":"text"},{"text":" ","type":"text"},{"text":"of designing high-quality prompts so that the model generates a best possible","type":"text"},{"text":" ","type":"text"},{"text":"response for the request you make. A prompt can be as short as “hello”, or as","type":"text"},{"text":" ","type":"text"},{"text":"long as multiple paragraphs. The process of designing a prompt involves a lot of","type":"text"},{"text":" ","type":"text"},{"text":"exploration to discover the best prompt, and involves optimizing prompt length","type":"text"},{"text":" ","type":"text"},{"text":"and writing style.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When thinking about the prompt you want to use in your app, consider using","type":"text"},{"text":" ","type":"text"},{"text":"conversational language in the form of a question or command. For example,","type":"text"},{"text":" ","type":"text"},{"text":"“What’s a good month to visit Paris?” or “Generate a food truck menu.”","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Write prompts that focus on a single and specific task, like “Write a profile","type":"text"},{"text":" ","type":"text"},{"text":"for the dog breed Siberian Husky”. When a prompt is long and complicated, the","type":"text"},{"text":" ","type":"text"},{"text":"model takes longer to respond, and may respond in unpredictable ways. If you","type":"text"},{"text":" ","type":"text"},{"text":"have a complex generation task in mind, break the task down into a series of","type":"text"},{"text":" ","type":"text"},{"text":"specific prompts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can refine your prompt by telling the model exactly how much content it","type":"text"},{"text":" ","type":"text"},{"text":"should generate. A prompt like, “Write a profile for the dog breed Siberian","type":"text"},{"text":" ","type":"text"},{"text":"Husky” often takes a long time to process as the model generates a full","type":"text"},{"text":" ","type":"text"},{"text":"multi-paragraph essay. If you specify “using three sentences”, it speeds up","type":"text"},{"text":" ","type":"text"},{"text":"processing and generates a concise summary. Use phrases like “in a single","type":"text"},{"text":" ","type":"text"},{"text":"sentence” or “in a few words” to shorten the generation time and produce shorter","type":"text"},{"text":" ","type":"text"},{"text":"text.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Generate a longer response for a specific command.","let simple = \"Write me a story about pears.\"","","\/\/ Quickly generate a concise response.","let quick = \"Write the profile for the dog breed Siberian Husky using three sentences.\""],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"anchor":"Provide-instructions-to-the-model","level":2,"text":"Provide instructions to the model","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Instructions","isActive":true,"type":"reference"},{"text":" help steer the model in a way that fits the use case of your app.","type":"text"},{"text":" ","type":"text"},{"text":"The model obeys prompts at a lower priority than the instructions you provide.","type":"text"},{"text":" ","type":"text"},{"text":"When you provide instructions to the model, consider specifying details like:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"What the model’s role is; for example, “You are a mentor,” or “You are a movie","type":"text"},{"text":" ","type":"text"},{"text":"critic”.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"What the model should do, like “Help the person extract calendar events,” or","type":"text"},{"text":" ","type":"text"},{"text":"“Help the person by recommending search suggestions”.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"What the style preferences are, like “Respond as briefly as possible”.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"What the possible safety measures are, like “Respond","type":"text"},{"text":" ","type":"text"},{"text":"with ‘I can’t help with that’ if you’re asked to do something dangerous”.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use content you trust in instructions because the model follows them more","type":"text"},{"text":" ","type":"text"},{"text":"closely than the prompt itself. When you initialize a session with instructions,","type":"text"},{"text":" ","type":"text"},{"text":"it affects all prompts the model responds to in that session. Instructions can","type":"text"},{"text":" ","type":"text"},{"text":"also include example responses to help steer the model. When you add examples to","type":"text"},{"text":" ","type":"text"},{"text":"your prompt, you provide the model with a template that shows the model what a","type":"text"},{"text":" ","type":"text"},{"text":"good response looks like.","type":"text"}],"type":"paragraph"},{"anchor":"Generate-a-response","level":2,"text":"Generate a response","type":"heading"},{"inlineContent":[{"text":"To call the model with a prompt, call ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelSession\/respond(to:options:)-b2re","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"on your session. The response call is asynchronous because it may take a few","type":"text"},{"text":" ","type":"text"},{"text":"seconds for the on-device foundation model to generate the response.","type":"text"}],"type":"paragraph"},{"code":["let instructions = \"\"\"","    Suggest five related topics. Keep them concise (three to seven words) and make sure they \\","    build naturally from the person's topic.","    \"\"\"","","let session = LanguageModelSession(instructions: instructions)","","let prompt = \"Making homemade bread\"","let response = try await session.respond(to: prompt)"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"content":[{"inlineContent":[{"text":"A session can only handle a single request at a time, and causes a runtime","type":"text"},{"text":" ","type":"text"},{"text":"error if you call it again before the previous request finishes. Check ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelSession\/isResponding","isActive":true,"type":"reference"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"to verify the session is done processing the previous request before sending a new one.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"Instead of working with raw string output from the model, the framework offers","type":"text"},{"text":" ","type":"text"},{"text":"guided generation to generate a custom Swift data structure you define. For more","type":"text"},{"text":" ","type":"text"},{"text":"information about guided generation, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/generating-swift-data-structures-with-guided-generation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you make a request to the model, you can provide custom tools to help the","type":"text"},{"text":" ","type":"text"},{"text":"model complete the request. If the model determines that a ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool","isActive":true,"type":"reference"},{"text":" can assist with","type":"text"},{"text":" ","type":"text"},{"text":"the request, the framework calls your ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Tool","isActive":true,"type":"reference"},{"text":" to perform additional actions like","type":"text"},{"text":" ","type":"text"},{"text":"retrieving content from your local database. For more information about tool","type":"text"},{"text":" ","type":"text"},{"text":"calling, see ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/expanding-generation-with-tool-calling","isActive":true,"type":"reference"}],"type":"paragraph"},{"anchor":"Consider-context-size-limits-per-session","level":2,"text":"Consider context size limits per session","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"text":"context window size","type":"text"}],"type":"emphasis"},{"text":" is a limit on how much data the model can process for a","type":"text"},{"text":" ","type":"text"},{"text":"session instance. A token is a chunk of text the model processes, and the system","type":"text"},{"text":" ","type":"text"},{"text":"model supports up to 4,096 tokens. A single token corresponds to three or four","type":"text"},{"text":" ","type":"text"},{"text":"characters in languages like English, Spanish, or German, and one token per character","type":"text"},{"text":" ","type":"text"},{"text":"in languages like Japanese, Chinese, or Korean. In a single session, the","type":"text"},{"text":" ","type":"text"},{"text":"sum of all tokens in the instructions, all prompts, and all outputs count toward","type":"text"},{"text":" ","type":"text"},{"text":"the context window size.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your session processes a large amount of tokens that exceed the context","type":"text"},{"text":" ","type":"text"},{"text":"window, the framework throws the error ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelError\/contextSizeExceeded(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When you encounter the error, remove entries from the transcript and try again.","type":"text"},{"text":" ","type":"text"},{"text":"If you need to process a large amount of data that won’t fit in a single context","type":"text"},{"text":" ","type":"text"},{"text":"window limit, break your data into smaller chunks, process each chunk in a","type":"text"},{"text":" ","type":"text"},{"text":"separate session, and then combine the results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For more information on managing the context window size, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/managing-the-context-window","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Tune-generation-options-and-optimize-performance","level":2,"text":"Tune generation options and optimize performance","type":"heading"},{"inlineContent":[{"text":"To get the best results for your prompt, experiment with different generation","type":"text"},{"text":" ","type":"text"},{"text":"options. ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/GenerationOptions","isActive":true,"type":"reference"},{"text":" affects the runtime parameters of the","type":"text"},{"text":" ","type":"text"},{"text":"model, and you can customize them for every request you make.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Customize the temperature to increase creativity.","let options = GenerationOptions(temperature: 1.0)","","let session = LanguageModelSession()","","let prompt = \"Write me a story about coffee.\"","let response = try await session.respond(","    to: prompt,","    options: options",")"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"inlineContent":[{"text":"When you test apps that use the framework, use Xcode Instruments to understand","type":"text"},{"text":" ","type":"text"},{"text":"more about the requests you make, like the time it takes to perform a request. When","type":"text"},{"text":" ","type":"text"},{"text":"you make a request, you can access the ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Transcript","isActive":true,"type":"reference"},{"text":" entries that describe the actions","type":"text"},{"text":" ","type":"text"},{"text":"the model takes during your ","type":"text"},{"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelSession","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Essentials","generated":true,"identifiers":["doc:\/\/com.apple.documentation\/documentation\/Updates\/FoundationModels","doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/adding-intelligent-app-features-with-generative-models"],"title":"Essentials"}],"variants":[{"paths":["\/documentation\/foundationmodels\/generating-content-and-performing-tasks-with-foundation-models"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"adding-intelligent-app-features-with-generative-models-PageImage-card.png":{"alt":"A screenshot of an itinerary planning app.","identifier":"adding-intelligent-app-features-with-generative-models-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.foundationmodels\/adding-intelligent-app-features-with-generative-models-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.foundationmodels\/adding-intelligent-app-features-with-generative-models-PageImage-card~dark@2x.png"}]},"doc://com.apple.documentation/documentation/Updates/FoundationModels":{"abstract":[{"text":"Learn about important changes to Foundation Models.","type":"text"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/Updates\/FoundationModels","kind":"article","role":"article","title":"Foundation Models updates","type":"topic","url":"\/documentation\/updates\/foundationmodels"},"doc://com.apple.documentation/documentation/technologies":{"abstract":[],"identifier":"doc:\/\/com.apple.documentation\/documentation\/technologies","kind":"technologies","role":"overview","title":"Technologies","type":"topic","url":"\/documentation\/technologies"},"doc://com.apple.foundationmodels/documentation/FoundationModels":{"abstract":[{"text":"Perform tasks with models that specialize in language understanding, structured output, and tool calling.","type":"text"}],"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels","images":[{"identifier":"foundation-models-framework-landing-PageImage-card.png","type":"card"}],"kind":"symbol","navigatorTitle":[{"kind":"text","text":"Foundation Models"}],"role":"collection","title":"Foundation Models","type":"topic","url":"\/documentation\/foundationmodels"},"doc://com.apple.foundationmodels/documentation/FoundationModels/GenerationOptions":{"abstract":[{"text":"Options that control how the model generates its response to a prompt.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GenerationOptions"}],"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/GenerationOptions","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GenerationOptions"}],"role":"symbol","title":"GenerationOptions","type":"topic","url":"\/documentation\/foundationmodels\/generationoptions"},"doc://com.apple.foundationmodels/documentation/FoundationModels/Instructions":{"abstract":[{"text":"Details you provide that define the model’s intended behavior on prompts.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Instructions"}],"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/Instructions","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Instructions"}],"role":"symbol","title":"Instructions","type":"topic","url":"\/documentation\/foundationmodels\/instructions"},"doc://com.apple.foundationmodels/documentation/FoundationModels/LanguageModelError/contextSizeExceeded(_:)":{"abstract":[{"text":"The session’s transcript exceeded the model’s context size.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"contextSizeExceeded"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16FoundationModels18LanguageModelErrorO","text":"LanguageModelError"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FoundationModels18LanguageModelErrorO19ContextSizeExceededV","text":"ContextSizeExceeded"},{"kind":"text","text":")"}],"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelError\/contextSizeExceeded(_:)","kind":"symbol","role":"symbol","title":"LanguageModelError.contextSizeExceeded(_:)","type":"topic","url":"\/documentation\/foundationmodels\/languagemodelerror\/contextsizeexceeded(_:)"},"doc://com.apple.foundationmodels/documentation/FoundationModels/LanguageModelSession":{"abstract":[{"text":"An object that represents a session that interacts with a language model.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LanguageModelSession"}],"identifier":"doc:\/\/com.apple.foundationmodels\/documentation\/FoundationModels\/LanguageModelSession","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LanguageModelSession"}],"role":"symbol","title":"LanguageModelSession","type":"topic","url":"\/documentation\/foundationmodels\/languagemodelsession"},"doc://com.apple.foundationmodels/documentation/FoundationModels/LanguageModelSession/isResponding":{"abstract":[{"text":"A Boolean value that indicates whether a response is being generated.","type":"text"}],"fragments":[{"kind":"keyword"