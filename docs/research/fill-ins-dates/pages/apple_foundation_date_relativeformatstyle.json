{"abstract":[{"text":"A format style that forms locale-aware string representations of a relative date or time.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.foundation\/documentation\/Foundation","doc:\/\/com.apple.foundation\/documentation\/Foundation\/Date"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/Date\/RelativeFormatStyle"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"extendedModule":"Foundation","externalID":"s:10Foundation4DateV19RelativeFormatStyleV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RelativeFormatStyle"}],"modules":[{"name":"Foundation"}],"navigatorTitle":[{"kind":"identifier","text":"RelativeFormatStyle"}],"platforms":[{"introducedAt":"15.0","name":"iOS"},{"introducedAt":"15.0","name":"iPadOS"},{"introducedAt":"15.0","name":"Mac Catalyst"},{"introducedAt":"12.0","name":"macOS"},{"introducedAt":"15.0","name":"tvOS"},{"introducedAt":"1.0","name":"visionOS"},{"introducedAt":"8.0","name":"watchOS"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"Date.RelativeFormatStyle"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst","macOS","tvOS","visionOS","watchOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RelativeFormatStyle"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use the strings that the format style produces, such as “1 hour ago”, “in 2 weeks”, “yesterday”, and “tomorrow” as standalone strings. Embedding them in other strings may not be grammatically correct.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Express relative date formats in either ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/Date\/RelativeFormatStyle\/Presentation-swift.struct\/numeric","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/Date\/RelativeFormatStyle\/Presentation-swift.struct\/named","isActive":true,"type":"reference"},{"text":" styles. For example:","type":"text"}],"type":"paragraph"},{"code":["if let past = Calendar.current.date(byAdding: .day, value: -7, to: Date()) {","    var formatStyle = Date.RelativeFormatStyle()","    ","    formatStyle.presentation = .numeric","    past.formatted(formatStyle) \/\/ \"1 week ago\"","    ","    formatStyle.presentation = .named","    past.formatted(formatStyle) \/\/ \"last week\"","}"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"inlineContent":[{"text":"Use the convenient static factory method ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/FormatStyle\/relative(presentation:unitsStyle:)","isActive":true,"type":"reference"},{"text":" to shorten the syntax when applying presentation and units style modifiers to customize the format. For example:","type":"text"}],"type":"paragraph"},{"code":["if let past = Calendar.current.date(byAdding: .day, value: 7, to: Date()) {","","    past.formatted(.relative(presentation: .numeric)) \/\/ \"in 1 week\"","    past.formatted(.relative(presentation: .named)) \/\/ \"next week\"","","    past.formatted(.relative(presentation: .named, unitsStyle: .wide)) \/\/ \"next week\"","    past.formatted(.relative(presentation: .named, unitsStyle: .narrow)) \/\/ \"next wk.\"","    past.formatted(.relative(presentation: .named, unitsStyle: .abbreviated)) \/\/ \"next wk.\"","    past.formatted(.relative(presentation: .named, unitsStyle: .spellOut)) \/\/ \"next week\"","    past.formatted(.relative(presentation: .numeric, unitsStyle: .wide)) \/\/ \"in 1 week\"","    past.formatted(.relative(presentation: .numeric, unitsStyle: .narrow)) \/\/ \"in 1 wk.\"","    past.formatted(.relative(presentation: .numeric, unitsStyle: .abbreviated)) \/\/ \"in 1 wk.\"","    past.formatted(.relative(presentation: .numeric, unitsStyle: .spellOut)) \/\/ \"in one week\"","}"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.apple.foundation\/documentation\/Foundation\/Date\/FormatStyle\/format(_:)","isActive":true,"type":"reference"},{"text":" instance method generates a string from the provided relative date. Once you create a style, you can use it to format relative dates multiple times.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example applies a format style repeatedly to produce string representations of relative dates:","type":"text"}],"type":"paragraph"},{"code":["if let pastWeek = Calendar.current.date(byAdding: .day, value: -7, to: Date()), ","  let pastDay = Calendar.current.date(byAdding: .day, value: -1, to: Date()) {","","    let formatStyle = Date.RelativeFormatStyle(","        presentation: .named,","        unitsStyle: .spellOut,","        locale: Locale(identifier: \"en_GB\"),","        calendar: Calendar.current,","        capitalizationContext: .beginningOfSentence)","        ","    formatStyle.format(pastDay) \/\/ \"Yesterday\"","    formatStyle.format(pastWeek) \/\/ \"Last week\"","}"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\