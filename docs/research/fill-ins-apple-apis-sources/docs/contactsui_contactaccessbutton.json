{"abstract":[{"text":"A SwiftUI button that you use to add to the set of contacts someone shares with","type":"text"},{"text":" ","type":"text"},{"text":"your app.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.Contacts-UI\/documentation\/ContactsUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Contacts-UI\/documentation\/ContactsUI\/ContactAccessButton"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"s:10ContactsUI19ContactAccessButtonV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContactAccessButton"}],"modules":[{"name":"Contacts UI"}],"navigatorTitle":[{"kind":"identifier","text":"ContactAccessButton"}],"platforms":[{"introducedAt":"18.0","name":"iOS"},{"introducedAt":"18.0","name":"iPadOS"},{"introducedAt":"18.0","name":"Mac Catalyst"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"ContactAccessButton"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"attribute","text":"@"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/MainActor","kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"attribute","text":"@preconcurrency"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContactAccessButton"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"When someone’s using your app, they can choose to give the app full access to","type":"text"},{"text":" ","type":"text"},{"text":"their contacts or to a subset of contacts. They choose this subset of contacts","type":"text"},{"text":" ","type":"text"},{"text":"the first time your app requests access with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Contacts\/CNContactStore\/requestAccess(for:completionHandler:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and can update them in the Settings app. You use this button to prompt them to","type":"text"},{"text":" ","type":"text"},{"text":"authorize additional contacts for your app to use while operating under","type":"text"},{"text":" ","type":"text"},{"text":"limited-access authorization.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use this button in addition to a search UI in your app, such as a text field.","type":"text"},{"text":" ","type":"text"},{"text":"Initialize the button with a query string from your search UI, along with email","type":"text"},{"text":" ","type":"text"},{"text":"addresses and phone numbers to ignore. If a single contact matches, the button","type":"text"},{"text":" ","type":"text"},{"text":"shows that contact’s name and image, and tapping the button grants your app","type":"text"},{"text":" ","type":"text"},{"text":"access to that contact. If multiple contacts match, tapping the button navigates","type":"text"},{"text":" ","type":"text"},{"text":"to another view where the person can choose which contacts to allow. The button","type":"text"},{"text":" ","type":"text"},{"text":"updates its display as the query string changes; using a query string bound to a","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/TextField","isActive":true,"type":"reference"},{"text":" allows","type":"text"},{"text":" ","type":"text"},{"text":"the button to update its display of matches in real time as the person types.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"This button is only useful when your app has limited or no access to","type":"text"},{"text":" ","type":"text"},{"text":"contacts. To see what level of access your app has to a person’s contacts,","type":"text"},{"text":" ","type":"text"},{"text":"call ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Contacts\/CNContactStore\/authorizationStatus(for:)","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If the returned value is ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Contacts\/CNAuthorizationStatus\/limited","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the button updates itself to show partial or single matches based on the query","type":"text"},{"text":" ","type":"text"},{"text":"string. If the authorization status is  ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Contacts\/CNAuthorizationStatus\/denied","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the button shows a prompt to allow access to contacts. If the authorization","type":"text"},{"text":" ","type":"text"},{"text":"status is ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Contacts\/CNAuthorizationStatus\/authorized","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the button doesn’t appear at all.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"To show a picker of all contacts and allow someone to add them to your app,","type":"text"},{"text":" ","type":"text"},{"text":"without presenting your own search UI, use ","type":"te