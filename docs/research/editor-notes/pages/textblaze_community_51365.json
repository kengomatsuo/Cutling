{"post_stream":{"posts":[{"id":102974,"name":"Diego Sala","username":"Diego_Sala","avatar_template":"/user_avatar/community.blaze.today/diego_sala/{size}/14730_2.png","created_at":"2025-06-25T10:27:49.391Z","cooked":"\u003cp\u003eThe 25,000 character limit for snippets has become too restrictive for me. Is it possible to increase it?\u003c/p\u003e\n\u003cp\u003eI get this message:\u003cbr\u003e\n\u003cimg src=\"https://community.blaze.today/uploads/default/original/2X/b/bd6682259c55cb1fa3cb3ebf401929f0af1f0898.png\" alt=\"image\" data-base62-sha1=\"r1vRDwhfLUVIcQugog9ziTPyRLy\" width=\"490\" height=\"52\"\u003e\u003cbr\u003e\nand I likely need at least 50,000 characters, better even much more.\u003c/p\u003e\n\u003cp\u003eI use snippets to store and use my prompts with various LLMs, and some of my prompts are large because they include large text attachments that serve as context.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2025-06-25T10:27:49.391Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":112,"reads":22,"readers_count":21,"score":564.4,"yours":false,"topic_id":51365,"topic_slug":"25k-character-limit-too-small-for-snippets","display_username":"Diego Sala","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":18616,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/25k-character-limit-too-small-for-snippets/51365/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"acc