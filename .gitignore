xcuserdata/
.DS_Store
ApiKey.p8
docs/_generator/.venv/
# Ignore the generator and its artifacts, but TRACK the hand-written docs that
# CLAUDE.md points at — a bare `docs/` excluded the directory itself, and git
# cannot re-include a file whose parent directory is excluded, so the prose
# docs were silently uncommittable.
docs/*
!docs/*.md
dist/
build/
web/_generator/__pycache__/
web/appcast.xml

# Generated test artifacts
*.log
test_output.xcresult/
test_result.json
snapshot_docs.txt
fastlane/report.xml

# Local crashlogs
crashlogs/
fastlane/screenshots/screenshots.html

# Signing certificates and keys (never commit)
certs/
*.p12
*.cer
*.certSigningRequest
*.p8
# App Store Connect API key (key_id + issuer_id + private key) — grants full
# ASC access, so it must never be committed.
fastlane/asc_api_key.json
