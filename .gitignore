xcuserdata/
.DS_Store
ApiKey.p8
docs/_generator/.venv/
# Ignore the generator and its artifacts, but TRACK the hand-written docs that
# CLAUDE.md points at — a bare `docs/` excluded the directory itself, and git
# cannot re-include a file whose parent directory is excluded, so the prose
# docs were silently uncommittable.
docs/*
!docs/*.md
# ASO research, measurements and probe scripts (docs/aso/data/README.md)
!docs/aso/
# Sourced research a decision rests on (docs/research/keyboard-memory-limits.md)
!docs/research/
dist/
build/
web/_generator/__pycache__/
web/appcast.xml

# Generated test artifacts
*.log
test_output.xcresult/
test_result.json
snapshot_docs.txt
fastlane/report.xml

# Local crashlogs
crashlogs/
fastlane/screenshots/screenshots.html

# Signing certificates and keys (never commit)
certs/
*.p12
*.cer
*.certSigningRequest
*.p8
# App Store Connect API key (key_id + issuer_id + private key) — grants full
# ASC access, so it must never be committed.
fastlane/asc_api_key.json

# Local preview launcher pointing at a session scratchpad
.claude/launch.json

# Rendered pages and frames of the store frame build; the published frames are fastlane/frames
fastlane/compose/creative/v2/out/
__pycache__/

# The custom page and main page renders (2 GB); fastlane/frames and the upload set hold what ships
fastlane/compose/creative/cpp/out/
# Keys path traces (422 MB, rebuilt by `keys.py trace <set> --remote` on the Windows PC) and their logs
fastlane/compose/creative/cpp/keys/renders/
fastlane/compose/creative/cpp/keys/previews/
fastlane/compose/creative/cpp/keys/*.log
fastlane/compose/creative/cpp/keys/.*-done
fastlane/compose/creative/cpp/keys/trace.progress
